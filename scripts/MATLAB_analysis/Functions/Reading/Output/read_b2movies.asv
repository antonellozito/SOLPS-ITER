function [state_variables_movies,fluxes_movies,sources_movies] = read_b2movies(varargin)
%
% read_b2movies reads the b2movies.nc file created by B2.5
% Output is the structs "state_variables_movies", ""fluxes_movies
% and "sources_movies" with the 2D distributions of state variables,
% fluxes and sources (for both B2.5 and Eirene) on the B2.5 grid
% at all simulated times
%
% 1st input: main simulation structure
%
% Following inputs: strings which specify which subsets of fields
%                   should be read:
%                   - 'B25_STATE_VARIABLES'
%                   - 'B25_FLUXES'
%                   - 'B25_SOURCES'
%                   - 'EIRENE_STATE_VARIABLES'
%                   - 'EIRENE_FLUXES'
%                   - 'EIRENE_SOURCES'

%% PRELIMINARY OPERATIONS

% Load the files (b2fstate/b2fstati)

simulation = varargin{1};

index_state = find(contains({simulation.run.name},'b2fstate'));
index_stati = find(contains({simulation.run.name},'b2fstati'));
if isempty(index_state) && isempty(index_stati)
    error('b2fstate/b2fstati not found');
end
fid_state = simulation.run(index_state).fid;
fid_stati = simulation.run(index_stati).fid;
if (fid_state == -1) && (fid_stati == -1)
    error('b2fstate/b2fstati not found');
end
if not(fid_state == -1)
    fid = fid_state;
elseif (fid_state == -1) && not(fid_stati == -1)
    fid = fid_stati;
end

line    = fgetl(fid);
version = line(8:17);

% Read the dimensions

if str2num(strrep(version,'.','')) >= str2num(strrep('03.002.000','.',''))

    version = 'unstructured';

    dim = scan_b2_int(fid,'nCv,nFc,ns',3);
    nCv  = dim(1);
    nFc  = dim(2);
    ns   = dim(3);

    b2fstate_nCv = nCv;
    b2fstate_nFc = nFc;
    b2fstate_ns = ns;

else

    version = 'structured';

    dim = scan_b2_int(fid,'nx,ny,ns',3);
    nx  = dim(1);
    ny  = dim(2);
    ns  = dim(3);
    
    b2fstate_nx = nx;
    b2fstate_ny = ny;
    b2fstate_ns = ns;
    
end

frewind(fid);

if any(strcmp(varargin,'EIRENE_STATE_VARIABLES')) || any(strcmp(varargin,'EIRENE_FLUXES')) || any(strcmp(varargin,'EIRENE_SOURCES'))

% Load the file (fort.44)

simulation = varargin{1};

index = find(contains({simulation.run.name},'fort.44'));
if isempty(index)
   error('fort.44 not found');
end
fid = simulation.run(index).fid;
if (fid == -1)
   error('fort.44 not found');
end

line = fgetl(fid);
countEntries = @(str) sum(~cellfun(@isempty, strsplit(str)));
n = countEntries(line);
if n==4
    version = 'structured';
elseif n==3
    version = 'unstructured';
end

frewind(fid);

if strcmp(version,'structured')

    dims = fscanf(fid,'%d',3);
    nx   = dims(1);
    ny   = dims(2);

    fort_44_nx = nx;
    fort_44_ny = ny;

elseif strcmp(version,'unstructured')

    dims = fscanf(fid,'%d',3);
    nCv   = dims(1);

    fort_44_nCv = nCv;

end

frewind(fid);

% Read the number of species (fort.44)

fgetl(fid);

dims = fscanf(fid,'%d',3);
natm = dims(1);
nmol = dims(2);
nion = dims(3);
fort_44_natm = natm;
fort_44_nmol = nmol;
fort_44_nion = nion;

line = fgetl(fid);
for i = 1:natm
    line = fgetl(fid);
    fort_44_species_atm{i} = strtrim(line);
end
for i = 1:nmol
    line = fgetl(fid);
    fort_44_species_mol{i} = strtrim(line);
end
for i = 1:nion
    line = fgetl(fid);
    fort_44_species_ion{i} = strtrim(line);
end

end

% Load the file (b2movies.nc)

simulation = varargin{1};

index = find(contains({simulation.run.name},'b2movies.nc'));
if isempty(index)
   error('b2movies.nc not found');
end
file = simulation.run(index).file;
fid = simulation.run(index).fid;
if (fid == -1)
   error('b2movies.nc not found');
end

try
    index_balance = find(contains({simulation.run.name},'balance.nc'));
    if not(isempty(index_balance))
        fid_balance = simulation.run(index_balance).fid;
        file_balance = simulation.run(index_balance).file;
    end
catch
end

%% READ THE STATE VARIABLES

state_variables_movies = [];

if any(strcmp(varargin,'B25_STATE_VARIABLES')) || any(strcmp(varargin,'EIRENE_STATE_VARIABLES'))

state_variables_movies.times = ncread(file,'times');

if any(strcmp(varargin,'B25_STATE_VARIABLES'))

try

if strcmp(version,'structured')

    state_variables_movies.nx = b2fstate_nx;
    state_variables_movies.ny = b2fstate_ny;
    state_variables_movies.ns = b2fstate_ns;

elseif strcmp(version,'unstructured')

    state_variables_movies.nCv = b2fstate_nCv;
    state_variables_movies.nFc = b2fstate_nFc;
    state_variables_movies.ns = b2fstate_ns;

end

if not(isempty(index_balance)) && not(fid_balance == -1)
    temp = ncread(file_balance,'species');
    temp1 = ncread(file,'na');
    state_variables_movies.species = {};
    for i=1:size(temp1,3)
        state_variables_movies.species{i} = strtrim(temp(:,i)');
    end
end

temp_data = ncread(file,'na');
state_variables_movies.na.value = temp_data;
state_variables_movies.na.description = 'atomic density for each species';
state_variables_movies.na.unit = 'm^-3';
state_variables_movies.na.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'ne');
state_variables_movies.ne.value = temp_data;
state_variables_movies.ne.description = 'electron density';
state_variables_movies.ne.unit = 'm^-3';
state_variables_movies.ne.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

try
temp_data = ncread(file,'ua');
state_variables_movies.ua.value = temp_data;
state_variables_movies.ua.description = 'parallel velocity';
state_variables_movies.ua.unit = 'm s^-1';
state_variables_movies.ua.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);
catch
end

temp_data = ncread(file,'te');
state_variables_movies.Te.value = temp_data;
state_variables_movies.Te.description = 'electron temperature';
state_variables_movies.Te.unit = 'eV';
state_variables_movies.Te.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'ti');
state_variables_movies.Ti.value = temp_data;
state_variables_movies.Ti.description = 'ion temperature';
state_variables_movies.Ti.unit = 'eV';
state_variables_movies.Ti.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'po');
state_variables_movies.po.value = temp_data;
state_variables_movies.po.description = 'electric potential';
state_variables_movies.po.unit = 'V';
state_variables_movies.po.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

catch
end

end

if any(strcmp(varargin,'EIRENE_STATE_VARIABLES'))

try

if strcmp(version,'structured')

    state_variables_movies.nx = fort_44_nx;
    state_variables_movies.ny = fort_44_ny;

elseif strcmp(version,'unstructured')

    state_variables_movies.nCv = fort_44_nCv;

end

state_variables_movies.natm = fort_44_natm;
state_variables_movies.nmol = fort_44_nmol;
state_variables_movies.nion = fort_44_nion;
state_variables_movies.species_atm = fort_44_species_atm;
state_variables_movies.species_mol = fort_44_species_mol;
state_variables_movies.species_ion = fort_44_species_ion;

temp_data = ncread(file,'dab2');
state_variables_movies.n_atm.value = temp_data;
state_variables_movies.n_atm.description = 'atomic density';
state_variables_movies.n_atm.unit = 'm^-3';
state_variables_movies.n_atm.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'tab2');
state_variables_movies.T_atm.value = temp_data;
state_variables_movies.T_atm.description = 'atomic temperature';
state_variables_movies.T_atm.unit = 'eV';
state_variables_movies.T_atm.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'dmb2');
state_variables_movies.n_mol.value = temp_data;
state_variables_movies.n_mol.description = 'molecular density';
state_variables_movies.n_mol.unit = 'm^-3';
state_variables_movies.n_mol.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'tmb2');
state_variables_movies.T_mol.value = temp_data;
state_variables_movies.T_mol.description = 'molecular temperature';
state_variables_movies.T_mol.unit = 'eV';
state_variables_movies.T_mol.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

catch
end

end

fprintf('Structure STATE_VARIABLES_MOVIES from b2movies.nc read.\n');

end

%% READ THE FLUXES

fluxes_movies = [];

if any(strcmp(varargin,'B25_FLUXES')) || any(strcmp(varargin,'EIRENE_FLUXES'))

fluxes_movies.times = ncread(file,'times');

if any(strcmp(varargin,'B25_FLUXES'))

try

if strcmp(version,'structured')

    fluxes_movies.nx = b2fstate_nx;
    fluxes_movies.ny = b2fstate_ny;
    fluxes_movies.ns = b2fstate_ns;

elseif strcmp(version,'unstructured')

    fluxes_movies.nCv = b2fstate_nCv;
    fluxes_movies.nFc = b2fstate_nFc;
    fluxes_movies.ns = b2fstate_ns;

end

if not(isempty(index_balance)) && not(fid_balance == -1)
    temp = ncread(file_balance,'species');
    temp1 = ncread(file,'fnax');
    fluxes_movies.species = {};
    for i=1:size(temp1,3)
        fluxes_movies.species{i} = strtrim(temp(:,i)');
    end
end

temp_data = ncread(file,'fnax');
fluxes_movies.fnax.value = temp_data;
fluxes_movies.fnax.description = 'atomic particle flux for each species (x-direction)';
fluxes_movies.fnax.unit = 's^-1';
fluxes_movies.fnax.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fnay');
fluxes_movies.fnay.value = temp_data;
fluxes_movies.fnay.description = 'atomic particle flux for each species (y-direction)';
fluxes_movies.fnay.unit = 's^-1';
fluxes_movies.fnay.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fhex');
fluxes_movies.fhex.value = temp_data;
fluxes_movies.fhex.description = 'electron heat flux (x-direction)';
fluxes_movies.fhex.unit = 'W';
fluxes_movies.fhex.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fhey');
fluxes_movies.fhey.value = temp_data;
fluxes_movies.fhey.description = 'electron heat flux (y-direction)';
fluxes_movies.fhey.unit = 'W';
fluxes_movies.fhey.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fhix');
fluxes_movies.fhix.value = temp_data;
fluxes_movies.fhix.description = 'ion heat flux (x-direction)';
fluxes_movies.fhix.unit = 'W';
fluxes_movies.fhix.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fhiy');
fluxes_movies.fhiy.value = temp_data;
fluxes_movies.fhiy.description = 'ion heat flux (y-direction)';
fluxes_movies.fhiy.unit = 'W';
fluxes_movies.fhiy.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fchx');
fluxes_movies.fchx.value = temp_data;
fluxes_movies.fchx.description = 'electric current (x-direction)';
fluxes_movies.fchx.unit = 'A';
fluxes_movies.fchx.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'fchy');
fluxes_movies.fchy.value = temp_data;
fluxes_movies.fchy.description = 'electric current (y-direction)';
fluxes_movies.fchy.unit = 'A';
fluxes_movies.fchy.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

catch
end

end

if any(strcmp(varargin,'EIRENE_FLUXES'))

try

if strcmp(version,'structured')

    fluxes_movies.nx = fort_44_nx;
    fluxes_movies.ny = fort_44_ny;

elseif strcmp(version,'unstructured')

    fluxes_movies.nCv = fort_44_nCv;

end

fluxes_movies.natm = fort_44_natm;
fluxes_movies.nmol = fort_44_nmol;
fluxes_movies.nion = fort_44_nion;
fluxes_movies.species_atm = fort_44_species_atm;
fluxes_movies.species_mol = fort_44_species_mol;
fluxes_movies.species_ion = fort_44_species_ion;

temp_data = ncread(file,'rfluxa');
fluxes_movies.fn_atm_y.value = temp_data;
fluxes_movies.fn_atm_y.description = 'atomic particle flux (y-direction)';
fluxes_movies.fn_atm_y.unit = 's^-1';
fluxes_movies.fn_atm_y.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'pfluxa');
fluxes_movies.fn_atm_x.value = temp_data;
fluxes_movies.fn_atm_x.description = 'atomic particle flux (x-direction)';
fluxes_movies.fn_atm_x.unit = 's^-1';
fluxes_movies.fn_atm_x.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'refluxa');
fluxes_movies.fe_atm_y.value = temp_data;
fluxes_movies.fe_atm_y.description = 'atomic energy flux (y-direction)';
fluxes_movies.fe_atm_y.unit = 'W';
fluxes_movies.fe_atm_y.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'pefluxa');
fluxes_movies.fe_atm_x.value = temp_data;
fluxes_movies.fe_atm_x.description = 'atomic energy flux (x-direction)';
fluxes_movies.fe_atm_x.unit = 'W';
fluxes_movies.fe_atm_x.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rfluxm');
fluxes_movies.fn_mol_y.value = temp_data;
fluxes_movies.fn_mol_y.description = 'molecular particle flux (y-direction)';
fluxes_movies.fn_mol_y.unit = 's^-1';
fluxes_movies.fn_mol_y.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'pfluxm');
fluxes_movies.fn_mol_x.value = temp_data;
fluxes_movies.fn_mol_x.description = 'molecular particle flux (x-direction)';
fluxes_movies.fn_mol_x.unit = 's^-1';
fluxes_movies.fn_mol_x.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'refluxm');
fluxes_movies.fe_mol_y.value = temp_data;
fluxes_movies.fe_mol_y.description = 'molecular energy flux (y-direction)';
fluxes_movies.fe_mol_y.unit = 'W';
fluxes_movies.fe_mol_y.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'pefluxm');
fluxes_movies.fe_mol_x.value = temp_data;
fluxes_movies.fe_mol_x.description = 'molecular energy flux (x-direction)';
fluxes_movies.fe_mol_x.unit = 'W';
fluxes_movies.fe_mol_x.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

catch
end

end

fprintf('Structure FLUXES_MOVIES from b2movies.nc read.\n');

end

%% READ THE SOURCES

sources_movies = [];

if any(strcmp(varargin,'B25_SOURCES')) || any(strcmp(varargin,'EIRENE_SOURCES'))

sources_movies.times = ncread(file,'times');

if any(strcmp(varargin,'B25_SOURCES'))

try

if strcmp(version,'structured')

    sources_movies.nx = b2fstate_nx;
    sources_movies.ny = b2fstate_ny;
    sources_movies.ns = b2fstate_ns;

elseif strcmp(version,'unstructured')

    sources_movies.nCv = b2fstate_nCv;
    sources_movies.nFc = b2fstate_nFc;
    sources_movies.ns = b2fstate_ns;

end

if not(isempty(index_balance)) && not(fid_balance == -1)
    temp = ncread(file_balance,'species');
    temp1 = ncread(file,'rsana');
    sources_movies.species = {};
    for i=1:size(temp1,3)
        sources_movies.species{i} = strtrim(temp(:,i)');
    end
end

temp_data = ncread(file,'rsana');
sources_movies.rsana.value = temp_data;
sources_movies.rsana.description = 'atomic particle source';
sources_movies.rsana.unit = 'm^-3 s^-1';
sources_movies.rsana.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rsahi');
sources_movies.rsahi.value = temp_data;
sources_movies.rsahi.description = 'ion heat source';
sources_movies.rsahi.unit = 'W m^-3';
sources_movies.rsahi.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rsahisum');
sources_movies.rsahisum.value = temp_data;
sources_movies.rsahisum.description = 'total ion heat source';
sources_movies.rsahisum.unit = 'W m^-3';
sources_movies.rsahisum.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rrana');
sources_movies.rrana.value = temp_data;
sources_movies.rrana.description = 'recombination atomic particle source';
sources_movies.rrana.unit = 'm^-3 s^-1';
sources_movies.rrana.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rrahi');
sources_movies.rrahi.value = temp_data;
sources_movies.rrahi.description = 'recombination ion heat source';
sources_movies.rrahi.unit = 'W m^-3';
sources_movies.rrahi.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rrahisum');
sources_movies.rrahisum.value = temp_data;
sources_movies.rrahisum.description = 'total recombination ion heat source';
sources_movies.rrahisum.unit = 'W m^-3';
sources_movies.rrahisum.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rcxna');
sources_movies.rcxna.value = temp_data;
sources_movies.rcxna.description = 'charge exchange atomic particle source';
sources_movies.rcxna.unit = 'm^-3 s^-1';
sources_movies.rcxna.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rcxhi');
sources_movies.rcxhi.value = temp_data;
sources_movies.rcxhi.description = 'charge exchange ion heat source';
sources_movies.rcxhi.unit = 'W m^-3';
sources_movies.rcxhi.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rcxhisum');
sources_movies.rcxhisum.value = temp_data;
sources_movies.rcxhisum.description = 'total charge exchange ion heat source';
sources_movies.rcxhisum.unit = 'W m^-3';
sources_movies.rcxhisum.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rqahe');
sources_movies.rqahe.value = temp_data;
sources_movies.rqahe.description = 'electron heat source';
sources_movies.rqahe.unit = 'W m^-3';
sources_movies.rqahe.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rqahesum');
sources_movies.rqahesum.value = temp_data;
sources_movies.rqahesum.description = 'total electron heat source';
sources_movies.rqahesum.unit = 'W m^-3';
sources_movies.rqahesum.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rqrad');
sources_movies.rqrad.value = temp_data;
sources_movies.rqrad.description = 'radiative heat source';
sources_movies.rqrad.unit = 'W m^-3';
sources_movies.rqrad.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'rqradsum');
sources_movies.rqradsum.value = temp_data;
sources_movies.rqradsum.description = 'total radiative heat source';
sources_movies.rqradsum.unit = 'W m^-3';
sources_movies.rqradsum.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

catch
end

end

if any(strcmp(varargin,'EIRENE_SOURCES'))

try

if strcmp(version,'structured')

    sources_movies.nx = b2fstate_nx;
    sources_movies.ny = b2fstate_ny;
    sources_movies.ns = b2fstate_ns;

elseif strcmp(version,'unstructured')

    sources_movies.nCv = b2fstate_nCv;
    sources_movies.nFc = b2fstate_nFc;
    sources_movies.ns = b2fstate_ns;

end

sources_movies.natm = fort_44_natm;
sources_movies.nmol = fort_44_nmol;
sources_movies.nion = fort_44_nion;
sources_movies.species_atm = fort_44_species_atm;
sources_movies.species_mol = fort_44_species_mol;
sources_movies.species_ion = fort_44_species_ion;

temp_data = ncread(file,'eirene_papl_sna');
sources_movies.eirene_papl_sna.value = temp_data;
sources_movies.eirene_papl_sna.description = 'Eirene atomic particle source';
sources_movies.eirene_papl_sna.unit = 'm^-3 s^-1';
sources_movies.eirene_papl_sna.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'eirene_pmpl_sna');
sources_movies.eirene_pmpl_sna.value = temp_data;
sources_movies.eirene_pmpl_sna.description = 'Eirene molecular particle source';
sources_movies.eirene_pmpl_sna.unit = 'm^-3 s^-1';
sources_movies.eirene_pmpl_sna.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'eirene_pppl_sna');
sources_movies.eirene_pppl_sna.value = temp_data;
sources_movies.eirene_pppl_sna.description = 'Eirene test ion particle source';
sources_movies.eirene_pppl_sna.unit = 'm^-3 s^-1';
sources_movies.eirene_pppl_sna.dimensions = arrayfun(@num2str, size(temp_data), 'UniformOutput', false);

temp_data = ncread(file,'eirene_eael_she');
sources_movies.eirene_eael_sna.value = temp_data;
sources_movies.eirene_eael_sna.description = 'Eirene atomic electron heat source';
