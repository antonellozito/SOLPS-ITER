#!/bin/tcsh -f

# TODO: check if matlab runtime is really installed before skipping the
#       (re-)installation, instead of just checking the runtime installer

# Check if MATLAB executable is found
which matlab >& /dev/null
if ($status != 0) then
    echo "Error: MATLAB not found."
    echo 'Please add the MATLAB bin directory to your PATH (setenv PATH "/your/MATLAB/bin/directory:$PATH"), or load it as a module'
    # Or download the precompiled binaries... add option here
    exit 1
endif

# Check if MATLAB compiler is found
which mcc >& /dev/null
if ($status != 0) then
    echo "Error: MATLAB Compiler (mcc) not found."
    echo "Please install it from the MATLAB Add-On Manager"
    # Or download the precompiled binaries... add option here
    exit 1
endif

# Check MATLAB version (requires at least R2025a)
set temp_matlab_script = "/tmp/matlab_version_$$.m"
set temp_matlab_output = "/tmp/matlab_version_out_$$.txt"
printf "v = version('-release'); fprintf('%%s', v);\n" > "$temp_matlab_script"
matlab -nodisplay -nosplash -nodesktop -batch "run('$temp_matlab_script')" >& "$temp_matlab_output"
set matlab_version = `tail -1 "$temp_matlab_output"`
rm -f "$temp_matlab_script" "$temp_matlab_output"

set matlab_year = `echo "$matlab_version" | sed 's/[ab]$//'`
set matlab_release = `echo "$matlab_version" | sed 's/.*\([ab]\)$/\1/'`

# Check if year is at least 2025
if ("$matlab_year" == "") then
    echo "Error: Could not determine MATLAB version."
    exit 1
endif

@ min_year = 2025
@ current_year = $matlab_year

if ($current_year < $min_year) then
    echo "Error: MATLAB R2025a or later is required for compilation."
    echo "Current version: R$matlab_version"
    echo "Please use a more recent of MATLAB to locally compile the scripts"
    # Or download the precompiled binaries... add option here
    exit 1
endif

echo "MATLAB version: R$matlab_version (OK)"

# Set up paths
set SOURCE_DIR = "$SOLPSTOP/scripts/MATLAB_analysis/Scripts"
set OUTPUT_DIR = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/Scripts"
set INCLUDE_DIR1 = "$SOLPSTOP/scripts/MATLAB_analysis"
set INCLUDE_DIR2 = "$SOLPSTOP/scripts.local/MATLAB_analysis"
set STARTUP_FILE = "$SOLPSTOP/scripts/MATLAB_analysis/startup.m"
set STARTUP_BACKUP = "$SOLPSTOP/scripts/MATLAB_analysis/startup.m.compile_backup"
set FUNCTIONS_SRC = "$SOLPSTOP/scripts/MATLAB_analysis/Functions"
set FUNCTIONS_DST = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/Functions"

if (! -d "$INCLUDE_DIR2") then
    mkdir -p "$INCLUDE_DIR2"
endif

# Temporarily rename startup.m to avoid warnings
set had_startup = 0
if (-e "$STARTUP_FILE") then
    mv "$STARTUP_FILE" "$STARTUP_BACKUP"
    set had_startup = 1
endif

# Create output directory if it doesn't exist
if (! -d "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER") then
    mkdir -p "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER"
endif
if (! -d "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis") then
    mkdir -p "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis"
endif
if (! -d "$OUTPUT_DIR") then
    mkdir -p "$OUTPUT_DIR"
    if ($status != 0) then
        echo "Error: Could not create output directory $OUTPUT_DIR"
        if ($had_startup == 1) then
            mv "$STARTUP_BACKUP" "$STARTUP_FILE"
        endif
        exit 1
    endif
endif

echo ""
echo "============================================================================================================="
echo "Starting MATLAB scripts compilation"
echo "============================================================================================================="
echo ""

# =============================================================================
# Copy Functions folder to compiled directory if it does not exist
# =============================================================================

if (! -d "$FUNCTIONS_DST") then
    echo "Syncing git-controlled function folder to compilation folder:"
    if (-d "$FUNCTIONS_SRC") then
        # Use rsync to copy only changed files (or cp -r if rsync not available)
        which rsync >& /dev/null
        if ($status == 0) then
            rsync -a --delete "$FUNCTIONS_SRC/" "$FUNCTIONS_DST/"
        else
            rm -rf "$FUNCTIONS_DST"
            cp -r "$FUNCTIONS_SRC" "$FUNCTIONS_DST"
        endif
        echo "---> Functions folder synced to $FUNCTIONS_DST"
    else
        echo "---> Warning: Functions folder not found at $FUNCTIONS_SRC"
    endif
    echo ""
endif

# Find all .m files recursively in Scripts directory
set m_files = `find "$SOURCE_DIR" -name "*.m" -type f`

if ($#m_files == 0) then
    echo "No .m files found in $SOURCE_DIR"
    if ($had_startup == 1) then
        mv "$STARTUP_BACKUP" "$STARTUP_FILE"
    endif
    exit 1
endif

set total_files = $#m_files
echo "Found $total_files MATLAB function(s) to check (this may take a while):"
echo ""

# Track if any compilation happened
set any_compilation = 0
set compiled_count = 0
set skipped_count = 0

# Compile each function (only if needed)
set current_num = 1
foreach m_file ($m_files)
    set func_name = `basename "$m_file" .m`
    
    # Get relative path by removing SOURCE_DIR prefix
    set rel_path = `echo "$m_file" | awk -v src="$SOURCE_DIR" '{sub("^"src"/", ""); print}'`
    set rel_dir = `dirname "$rel_path"`
    
    # Target directory: output/rel_dir/func_name/
    set target_dir = "$OUTPUT_DIR/$rel_dir/$func_name"
    set target_m_file = "$target_dir/$func_name.m"
    set target_deps_file = "$target_dir/function_dependencies.txt"
    
    # Check if compilation is needed
    set needs_compile = 0
    
    if (! -d "$target_dir") then
        # Folder doesn't exist - need to compile
        set needs_compile = 1
        echo -n "[$current_num/$total_files] $func_name"
        echo ": binary does not exist, function will compile"
    else if (! -f "$target_m_file") then
        # Folder exists but .m file is missing - need to recompile
        set needs_compile = 1
        echo -n "[$current_num/$total_files] $func_name"
        echo ": .m file missing, function will recompile"
    else if (! -f "$target_deps_file") then
        # Folder exists but dependencies file is missing - need to recompile
        set needs_compile = 1
        echo -n "[$current_num/$total_files] $func_name"
        echo ": dependencies file(s) missing, function will recompile"
    else
        # Compare source and target .m files
        diff -q "$m_file" "$target_m_file" >& /dev/null
        if ($status != 0) then
            # Files are different - need to recompile
            set needs_compile = 1
            echo -n "[$current_num/$total_files] $func_name"
            echo ": git-controlled source changed, function will recompile"
        else
            # Check if any dependency has changed
            set dep_changed = 0
            if (-f "$target_deps_file") then
                foreach dep_file (`cat "$target_deps_file"`)
                    if (-f "$dep_file") then
                        # Get the corresponding file in FUNCTIONS_DST
                        set dep_rel = `echo "$dep_file" | awk -v src="$FUNCTIONS_SRC" '{sub("^"src"/", ""); print}'`
                        set dep_dst = "$FUNCTIONS_DST/$dep_rel"

                        if (-f "$dep_dst") then
                            diff -q "$dep_file" "$dep_dst" >& /dev/null
                            if ($status != 0) then
                                set dep_changed = 1
                                break
                            endif
                        else
                            # Dependency file doesn't exist in dst - something changed
                            set dep_changed = 1
                            break
                        endif
                    else
                        # Source dependency file no longer exists
                        set dep_changed = 1
                        break
                    endif
                end
            endif
            
            if ($dep_changed == 1) then
                set needs_compile = 1
                echo -n "[$current_num/$total_files] $func_name"
                echo ": dependency changed, function will recompile"
            else
                # Files are identical - skip
                echo -n "[$current_num/$total_files] $func_name"
                echo ": compilation already up to date, skipping"
                @ skipped_count++
            endif
        endif
    endif
    
    if ($needs_compile == 1) then
        # Delete existing target directory if it exists
        if (-d "$target_dir") then
            rm -rf "$target_dir"
        endif
        
        # Create target directory
        mkdir -p "$target_dir"
        
        echo -n "    Compiling"
        echo ': $SOLPSTOP/scripts/MATLAB_analysis/Scripts/'"$rel_path"
        
        # First, get the list of dependencies and save it
        set temp_deps_list = "/tmp/func_deps_$$.txt"
        set temp_matlab_script = "/tmp/matlab_cmd_deps_$$.m"
        printf "addpath(genpath('%s/Functions')); addpath(genpath('%s')); [fList, ~] = matlab.codetools.requiredFilesAndProducts('%s'); fid = fopen('%s', 'w'); for i = 1:numel(fList), if contains(fList{i}, '%s'), fprintf(fid, '%%s\\n', fList{i}); end; end; fclose(fid);\n" "$INCLUDE_DIR1" "$INCLUDE_DIR2" "$m_file" "$temp_deps_list" "$FUNCTIONS_SRC" > "$temp_matlab_script"
        matlab -nodisplay -nosplash -nodesktop -batch "run('$temp_matlab_script')"
        rm -f "$temp_matlab_script"

        # Run MATLAB compiler in batch mode
        set temp_matlab_script = "/tmp/matlab_cmd_mcc_$$.m"
        printf "try; mcc -m -v -w off -o %s -d %s -a %s/Functions -a %s %s; exit(0); catch ME; disp(ME.message); exit(1); end\n" "$func_name" "$target_dir" "$INCLUDE_DIR1" "$INCLUDE_DIR2" "$m_file" > "$temp_matlab_script"
        matlab -nodisplay -nosplash -nodesktop -batch "run('$temp_matlab_script')" >& /dev/null
        rm -f "$temp_matlab_script"
        
        if ($status == 0) then
            # Copy the original .m file to the target directory
            cp "$m_file" "$target_m_file"
            
            # Copy the dependencies list to the target directory
            if (-f "$temp_deps_list") then
                cp "$temp_deps_list" "$target_deps_file"
            endif

            # Check if compiled binary exists
            if (`uname` == "Darwin") then
                if ( -e "$target_dir/$func_name.app" && -f "$target_dir/run_$func_name.sh" ) then
                    echo "---> Success: $func_name compiled"
                    set any_compilation = 1
                    @ compiled_count++
                else
                    echo "---> Failed: $func_name compilation failed"
                    # Remove the failed target directory
                    rm -rf "$target_dir"
                endif
            else if (`uname` == "Linux") then
                if ( -f "$target_dir/$func_name" && -f "$target_dir/run_$func_name.sh" ) then
                    echo "---> Success: $func_name compiled"
                    set any_compilation = 1
                    @ compiled_count++
                else
                    echo "---> Failed: $func_name compilation failed"
                    # Remove the failed target directory
                    rm -rf "$target_dir"
                endif
            endif
        else
            echo "---> Failed: $func_name compilation failed"
            # Remove the failed target directory
            rm -rf "$target_dir"
        endif
        
        rm -f "$temp_deps_list"
    endif
    
    echo ""
    @ current_num++
end

# Resync the functions in the compiled directory
echo "Re-syncing git-controlled function folder to compilation folder:"
if (-d "$FUNCTIONS_SRC") then
    # Use rsync to copy only changed files (or cp -r if rsync not available)
    which rsync >& /dev/null
    if ($status == 0) then
        rsync -a --delete "$FUNCTIONS_SRC/" "$FUNCTIONS_DST/"
    else
        rm -rf "$FUNCTIONS_DST"
        cp -r "$FUNCTIONS_SRC" "$FUNCTIONS_DST"
    endif
    echo "---> Functions folder synced to $FUNCTIONS_DST"
else
    echo "---> Warning: Functions folder not found at $FUNCTIONS_SRC"
endif

# =============================================================================
# Clean up orphaned compiled functions (source no longer exists)
# =============================================================================

echo ""
echo "Checking for orphaned compiled functions:"
set orphan_count = 0

# Find all compiled function directories (those containing run_*.sh)
set compiled_funcs = `find "$OUTPUT_DIR" -name "run_*.sh" -type f`

foreach run_script ($compiled_funcs)
    # Extract function name from run_funcname.sh
    set script_basename = `basename "$run_script" .sh`
    set func_name = `echo "$script_basename" | sed 's/^run_//'`
    
    # Get the directory containing this script
    set compiled_func_dir = `dirname "$run_script"`
    
    # Get the relative path from OUTPUT_DIR
    set rel_func_dir = `echo "$compiled_func_dir" | awk -v out="$OUTPUT_DIR" '{sub("^"out"/", ""); print}'`
    set rel_dir = `dirname "$rel_func_dir"`
    
    # Construct the expected source path
    set expected_source = "$SOURCE_DIR/$rel_dir/$func_name.m"
    
    # Check if source file exists
    if (! -f "$expected_source") then
        echo -n "    Removing orphaned"
        echo ":        $func_name (source no longer exists)"
        rm -rf "$compiled_func_dir"
        @ orphan_count++
    endif
end

if ($orphan_count > 0) then
    echo "---> Removed $orphan_count orphaned compiled function(s)"
else
    echo "---> No orphaned compiled functions found"
endif

echo ""

echo "============================================================================================================="
echo "Compilation completed: $compiled_count compiled, $skipped_count skipped (already up to date)"
echo "============================================================================================================="

# Create tarball of compiled scripts
echo ""
echo "Creating tarball of compiled scripts:"

if (`uname -s` == "Darwin") then
    if (`uname -m` == "arm64") then
        set platform_tar = "maca64"
    else
        set platform_tar = "maci64"
    endif
else
    set platform_tar = "glnxa64"
endif

set scripts_tarball = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/MATLAB_analysis_compiled_scripts_${platform_tar}_R${matlab_version}.tar.gz"
tar -czf "$scripts_tarball" -C "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis" Scripts
if ($status == 0) then
    echo "---> Tarball created: $scripts_tarball"
else
    echo "---> Warning: Failed to create compiled scripts tarball"
endif

# =============================================================================
# Runtime installer management
# =============================================================================

if ("$HOST_NAME" == "LINUX" || "$HOST_NAME" == "DARWIN") then
    if (! -d "$HOME/.local/share") then
        mkdir -p "$HOME/.local/share"
    endif
    set MATLAB_RUNTIME_DIR = "$HOME/.local/share/MATLAB_Runtime"
else
    set MATLAB_RUNTIME_DIR = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/MATLAB_Runtime"
endif

set RUNTIME_DIR = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/MATLAB_Runtime_installer"
set DEPS_FILE = "$RUNTIME_DIR/dependencies.txt"

# Collect all dependencies from buildresult.json files
set buildresult_files = `find "$OUTPUT_DIR" -name "buildresult.json" -type f`

if ($#buildresult_files == 0) then
    echo ""
    echo "---> Warning: No buildresult.json files found, skipping runtime installer"
    if ($had_startup == 1) then
        mv "$STARTUP_BACKUP" "$STARTUP_FILE"
    endif
    exit 0
endif

echo ""
echo "Checking runtime dependencies:"

# Create temporary file with sorted unique dependencies
set temp_deps = "/tmp/matlab_deps_$$.txt"
set temp_deps_new = "/tmp/matlab_deps_new_$$.txt"

# Write buildresult files to a temporary file
set temp_file_list = "/tmp/buildresult_list_$$.txt"
rm -f "$temp_file_list"
foreach br_file ($buildresult_files)
    echo "$br_file" >> "$temp_file_list"
end

# Use MATLAB to extract dependencies
set temp_matlab_script = "/tmp/matlab_cmd_rtdeps_$$.m"
printf "fid = fopen('%s', 'r'); files = textscan(fid, '%%s'); fclose(fid); files = files{1}; all_deps = []; for i = 1:numel(files), data = jsondecode(fileread(files{i})); if isfield(data, 'RuntimeDependencies'), deps = data.RuntimeDependencies; if isstruct(deps), all_deps = [all_deps; [deps.ID]']; end; end; end; all_deps = unique(all_deps); fid = fopen('%s', 'w'); for i = 1:numel(all_deps), fprintf(fid, '%%d\\n', all_deps(i)); end; fclose(fid);\n" "$temp_file_list" "$temp_deps_new" > "$temp_matlab_script"
matlab -nodisplay -nosplash -nodesktop -batch "run('$temp_matlab_script')"
rm -f "$temp_matlab_script"
rm -f "$temp_file_list"

if ($status != 0) then
    echo "---> Failed: Could not extract dependencies"
    rm -f "$temp_deps_new"
    if ($had_startup == 1) then
        mv "$STARTUP_BACKUP" "$STARTUP_FILE"
    endif
    exit 1
endif

if (! -f "$temp_deps_new") then
    echo "---> Failed: Dependencies file not created"
    if ($had_startup == 1) then
        mv "$STARTUP_BACKUP" "$STARTUP_FILE"
    endif
    exit 1
endif

echo "---> Dependencies correctly fetched"
echo ""

# Sort the new dependencies file
sort "$temp_deps_new" -o "$temp_deps_new"

# Check if we need to create/update the runtime installer
set needs_installer = 0

echo "Checking presence of MATLAB Runtime installer:"
if (! -d "$RUNTIME_DIR") then
    # No installer exists
    set needs_installer = 1
    echo "---> No MATLAB Runtime installer found, will create"
else if (! -f "$DEPS_FILE") then
    # Installer exists but no deps file
    set needs_installer = 1
    echo "---> Dependencies file missing, will recreate MATLAB Runtime installer"
else if ($any_compilation == 1) then
    # Something was compiled, check if deps changed
    sort "$DEPS_FILE" -o "$temp_deps"
    
    # Check if new deps are a superset of old deps
    # (i.e., there are new dependencies not in the old list)
    set new_deps_count = `comm -23 "$temp_deps_new" "$temp_deps" | wc -l`
    
    if ($new_deps_count > 0) then
        set needs_installer = 1
        echo "---> Found $new_deps_count new dependencies, will recreate MATLAB Runtime installer"
    else
        echo "---> Dependencies unchanged, keeping existing MATLAB Runtime installer"
    endif
    
    rm -f "$temp_deps"
endif

if ($needs_installer == 1) then
    
    # Remove old installer and runtime if they exist
    if (-d "$RUNTIME_DIR") then
        echo "---> Removing old MATLAB Runtime installer"
        rm -rf "$RUNTIME_DIR"
    endif
    if (-d "$MATLAB_RUNTIME_DIR") then
        echo "---> Removing old MATLAB Runtime application"
        rm -rf "$MATLAB_RUNTIME_DIR"
    endif
    
    mkdir -p "$RUNTIME_DIR"

    echo ""
    echo "Creating custom MATLAB Runtime installer:" 
    
    # Write buildresult files to a temporary file
    set temp_file_list = "/tmp/buildresult_list_$$.txt"
    rm -f "$temp_file_list"
    foreach br_file ($buildresult_files)
        echo "$br_file" >> "$temp_file_list"
    end  
    
    # Create MATLAB script to read the file list and call customInstaller
    set temp_matlab_script = "/tmp/matlab_cmd_installer_$$.m"
    printf "try; fid = fopen('%s', 'r'); files = textscan(fid, '%%s'); fclose(fid); files = files{1}; compiler.runtime.customInstaller('SOLPS_MATLAB_Runtime', files, 'OutputDir', '%s'); exit(0); catch ME; disp(ME.message); exit(1); end\n" "$temp_file_list" "$RUNTIME_DIR" > "$temp_matlab_script"
    matlab -nodisplay -nosplash -nodesktop -batch "run('$temp_matlab_script')" >& /dev/null
    rm -f "$temp_matlab_script"

    if ($status == 0) then
        echo "---> Success: Custom MATLAB Runtime installer created"
        echo -n "---> Location"
        echo ": $RUNTIME_DIR"
        
        # Save the dependencies list
        cp "$temp_deps_new" "$DEPS_FILE"
        echo "---> Dependencies list saved"
        
    else
        echo "---> Failed: Custom MATLAB Runtime installer creation failed"
        rm -f "$temp_file_list" "$temp_deps_new"
        if ($had_startup == 1) then
            mv "$STARTUP_BACKUP" "$STARTUP_FILE"
        endif
        exit 1
    endif
    
    rm -f "$temp_file_list"

    # Create tarball of runtime installer
    echo ""
    echo "Creating tarball of MATLAB Runtime installer:"
    set installer_tarball = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/MATLAB_analysis_runtime_installer_${platform_tar}_R${matlab_version}.tar.gz"
    tar -czf "$installer_tarball" -C "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis" MATLAB_Runtime_installer
    if ($status == 0) then
        echo "---> Tarball created: $installer_tarball"
    else
        echo "---> Warning: Failed to create runtime installer tarball"
    endif
    
    # =============================================================================
    # Install the MATLAB Runtime (only if installer was just created or downloaded)
    # =============================================================================
    
    echo ""
    echo "Installing MATLAB Runtime application:"
    
    # Determine if we use custom installer or full installer
    if ("$HOST_NAME" == "LINUX" || "$HOST_NAME" == "DARWIN") then
        # Local computer: use custom installer (downloads only required components)
        set use_full_installer = 0
        
        # Find the installer executable
        set installer_exe = ""
        if (-f "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.exe") then
            set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.exe"
        else if (-f "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.install") then
            set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.install"
        else if (-f "$RUNTIME_DIR/SOLPS_MATLAB_Runtime") then
            set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime"
        else if (-d "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.app") then
            set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.app/Contents/MacOS/setup"
        else if (-f "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.zip") then
            echo "Extracting runtime installer..."
            unzip -o "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.zip" -d "$RUNTIME_DIR"
            if (-f "$RUNTIME_DIR/SOLPS_MATLAB_Runtime") then
                set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime"
            else if (-f "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.exe") then
                set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.exe"
            else if (-d "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.app") then
                set installer_exe = "$RUNTIME_DIR/SOLPS_MATLAB_Runtime.app/Contents/MacOS/setup"
            endif
        endif
    else
        # Use full installer for HPC systems
        set use_full_installer = 1
        
        # Get MATLAB version for download URL
        set runtime_release = "$matlab_version"
        
        set platform_str = "glnxa64"

        set FULL_INSTALLER_DIR = "$SOLPSTOP/scripts/$HOST_NAME.$COMPILER/MATLAB_analysis/MATLAB_Runtime_installer_full"
        mkdir -p "$FULL_INSTALLER_DIR"
        
        # Download URL for full MATLAB Runtime
        set download_url = "https://ssd.mathworks.com/supportfiles/downloads/R${runtime_release}/Release/0/deployment_files/installer/complete/${platform_str}/MATLAB_Runtime_R${runtime_release}_${platform_str}.zip"
        
        set full_installer_zip = "$FULL_INSTALLER_DIR/MATLAB_Runtime_R${runtime_release}_${platform_str}.zip"
        set full_installer_dir = "$FULL_INSTALLER_DIR/MATLAB_Runtime_R${runtime_release}_${platform_str}"
        
        # Download the full installer if not already present
        if (! -f "$full_installer_zip" && ! -d "$full_installer_dir") then
            echo "---> Downloading full MATLAB Runtime installer (this may take a while)..."
            echo "---> URL: $download_url"
            
            # Try wget first, then curl
            which wget >& /dev/null
            if ($status == 0) then
                wget -q --show-progress -O "$full_installer_zip" "$download_url"
            else
                which curl >& /dev/null
                if ($status == 0) then
                    curl -L -o "$full_installer_zip" "$download_url"
                else
                    echo "---> Error: Neither wget nor curl found. Cannot download installer."
                    exit 1
                endif
            endif
            
            if ($status != 0 || ! -f "$full_installer_zip") then
                echo "---> Error: Failed to download MATLAB Runtime installer."
                rm -f "$full_installer_zip"
                exit 1
            endif
            
            echo "---> Download complete."
        endif
        
        # Extract the installer if needed
        if (-f "$full_installer_zip" && ! -d "$full_installer_dir") then
            echo "---> Extracting MATLAB Runtime installer..."
            unzip -q -o "$full_installer_zip" -d "$FULL_INSTALLER_DIR"
            
            if ($status != 0) then
                echo "---> Error: Failed to extract MATLAB Runtime installer."
                exit 1
            endif
            
            echo "---> Extraction complete."
        endif
        
        # Find the installer executable in the extracted directory
        set installer_exe = ""
        if (-f "$FULL_INSTALLER_DIR/install") then
            set installer_exe = "$FULL_INSTALLER_DIR/install"
        else if (-f "$FULL_INSTALLER_DIR/Install") then
            set installer_exe = "$FULL_INSTALLER_DIR/Install"
        else
            # Search for install script
            set found_install = `find "$FULL_INSTALLER_DIR" -name "install" -type f | head -1`
            if ("$found_install" != "") then
                set installer_exe = "$found_install"
            endif
        endif
    endif

    if ("$installer_exe" != "") then
        echo -n "---> Running installer"
        echo ": $installer_exe"
        echo -n "---> Installation directory"
        echo ": $MATLAB_RUNTIME_DIR"
        
        chmod +x "$installer_exe" >& /dev/null
        
        # Run installer in background with no stdin to prevent hanging
        "$installer_exe" -destinationFolder "$MATLAB_RUNTIME_DIR" -agreeToLicense yes -mode silent < /dev/null >& /dev/null &
        set installer_pid = $!
        
        echo "---> Installer started, waiting for completion (this may take a while)"
        
        # Wait for installation to start
        set wait_start = 0
        while (! -d "$MATLAB_RUNTIME_DIR" && $wait_start < 60)
            sleep 1
            @ wait_start++
            if ($wait_start % 10 == 0) then
                echo "---> Waiting for installation to start..."
            endif
        end
        
        if (! -d "$MATLAB_RUNTIME_DIR") then
            echo "---> Failed: Installation directory was not created"
        else
            # Monitor installation progress
            set last_size = 0
            set no_change_count = 0
            set wait_count = 0
            
            while (1)
                sleep 1
                @ wait_count++
                
                set current_size = `du -sk "$MATLAB_RUNTIME_DIR" |& grep -v "No such file" | head -1 | awk '{print $1}'`
                if ("$current_size" == "") set current_size = 0

                set prev_status = ""
                
                if ($wait_count % 5 == 0) then
                    set dir_size_human = `du -sh "$MATLAB_RUNTIME_DIR" |& grep -v "No such file" | head -1 | awk '{print $1}'`
                    set file_count = `find "$MATLAB_RUNTIME_DIR" -type f |& grep -v "No such file" | wc -l`
                    
                    set status_line = "---> Still installing... (${file_count} files processed)"
                    
                    # only print if different from previous
                    if ("$status_line" != "$prev_status") then
                        echo "$status_line"
                        set prev_status = "$status_line"
                    endif
                endif
                
                if ($current_size == $last_size) then
                    @ no_change_count++
                else
                    set no_change_count = 0
                    set last_size = $current_size
                endif
                
                if ($no_change_count >= 15) then
                    break
                endif
                
                if ($wait_count >= 1800) then
                    echo "---> Timeout: Installation of MATLAB runtime application failed."
                    break
                endif
            end
            
            sleep 2
            
            # Check if installation was successful
            set runtime_version = `ls "$MATLAB_RUNTIME_DIR" | grep -E '^R[0-9]{4}[ab]$|^v[0-9]+$' | head -1`
            if ("$runtime_version" != "") then

                # Check the local installation of MATLAB Runtime is good
                if (`uname -s` == "Darwin") then
                    if (`uname -m` == "arm64") then
                        set platform = "maca64"
                    else
                        set platform = "maci64"
                    endif
                    set libext = "dylib"
                else
                    set platform = "glnxa64"
                    set libext = "so"
                endif

                set runtime_valid = 1

                if (! -f "$MATLAB_RUNTIME_DIR/$runtime_version/bin/$platform/libmwmclmcr.$libext") then
                    set runtime_valid = 0
                else if (! -f "$MATLAB_RUNTIME_DIR/$runtime_version/bin/$platform/libmwmcr.$libext") then
                    set runtime_valid = 0
                endif

                if ($runtime_valid == 1) then
                    echo "---> Success: MATLAB Runtime application installed"
                    echo -n "---> Location"
                    echo ": $MATLAB_RUNTIME_DIR"
                else
                    echo "---> Failed: MATLAB Runtime installation is incomplete or corrupted"
                    exit 1
                endif

                # Remove full installer directory after successful installation
                if ("$HOST_NAME" != "LINUX" && "$HOST_NAME" != "DARWIN") then
                    if (-d "$FULL_INSTALLER_DIR") then
                        rm -rf "$FULL_INSTALLER_DIR"
                    endif
                endif
                
                # Add setup lines if they don't already exist
                set setup_file = "${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local"
                
                echo ""
                echo "Checking setup file for runtime paths:"
                
                # Determine OS and architecture
                if (`uname` == "Darwin") then
                    set arch = `uname -m`
                    if ("$arch" == "arm64") then
                        set mac_arch = "maca64"
                    else
                        set mac_arch = "maci64"
                    endif

                    # Check if lines already exist
                    grep -q "MATLAB_analysis/MATLAB_Runtime/${runtime_version}/runtime" "$setup_file"
                    if ($status == 0) then
                        echo "-> Setup lines already exist in $setup_file"
                    else
                        echo "" >> "$setup_file"
                        echo "# MATLAB Runtime paths" >> "$setup_file"
                        echo setenv DYLD_LIBRARY_PATH ${MATLAB_RUNTIME_DIR}/${runtime_version}/runtime/${mac_arch}:\$\{DYLD_LIBRARY_PATH\} >> "$setup_file"
                        echo setenv DYLD_LIBRARY_PATH ${MATLAB_RUNTIME_DIR}/${runtime_version}/bin/${mac_arch}:\$\{DYLD_LIBRARY_PATH\} >> "$setup_file"
                        echo "---> Added runtime paths to $setup_file"
                    endif

                else if (`uname` == "Linux") then
                    # Check if lines already exist
                    grep -q "MATLAB_analysis/MATLAB_Runtime/${runtime_version}/runtime" "$setup_file"
                    if ($status == 0) then
                        echo "---> Setup lines already exist in $setup_file"
                    else
                        echo "" >> "$setup_file"
                        echo "# MATLAB Runtime paths" >> "$setup_file"
                        echo setenv LD_LIBRARY_PATH ${MATLAB_RUNTIME_DIR}/${runtime_version}/runtime/glnxa64:\$\{LD_LIBRARY_PATH\} >> "$setup_file"
                        echo setenv LD_LIBRARY_PATH ${MATLAB_RUNTIME_DIR}/${runtime_version}/bin/glnxa64:\$\{LD_LIBRARY_PATH\} >> "$setup_file"
                        echo setenv LD_LIBRARY_PATH ${MATLAB_RUNTIME_DIR}/${runtime_version}/sys/os/glnxa64:\$\{LD_LIBRARY_PATH\} >> "$setup_file"
                        echo "---> Added runtime paths to $setup_file"
                    endif
                endif

                echo ""
                echo "============================================================================================================="
                echo "Installation of MATLAB Runtime application completed"
                echo "============================================================================================================="

                # =============================================================================
                # Warm up the MATLAB Runtime by running dummy functions
                # =============================================================================
                
                if ("$HOST_NAME" == "LINUX" || "$HOST_NAME" == "DARWIN") then

                    echo ""
                    echo "Warming up MATLAB Runtime (first run initialization)"
                    echo ""
                    
                    # Create a temporary directory for warmup functions
                    set warmup_dir = "/tmp/matlab_warmup_$$"
                    mkdir -p "$warmup_dir"
                    
                    # Build warmup MATLAB code based on installed dependencies
                    set warmup_code = "disp('Warming up MATLAB Runtime...');"
                    
                    # Check each dependency and add appropriate test code
                    # 35010 - MATLAB Base Runtime (always present)
                    grep -q '^35010$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing Base Runtime...'); x = 1:10; y = x.^2; assert(y(3) == 9);"
                    endif
                    
                    # 35000 - MATLAB Extended Runtime Addon
                    grep -q '^35000$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing Extended Runtime...'); s = struct('a', 1, 'b', 2); assert(s.a == 1);"
                    endif
                    
                    # 35002 - MATLAB Graphics Runtime Addon
                    grep -q '^35002$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing Graphics Runtime...'); f = figure('Visible', 'off'); plot(1:10); close(f);"
                    endif
                    
                    # 35003 - MATLAB Standard Runtime Addon
                    grep -q '^35003$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing Standard Runtime...'); m = rand(10); [U,S,V] = svd(m);"
                    endif
                    
                    # 35106 - Optimization Toolbox Runtime Addon
                    grep -q '^35106$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing Optimization Toolbox...'); fun = @(x) x(1)^2 + x(2)^2; x0 = [1,1]; options = optimoptions('fminunc','Display','off'); fminunc(fun, x0, options);"
                    endif
                    
                    # 35131 - Partial Differential Equation Toolbox Runtime Addon
                    grep -q '^35131$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing PDE Toolbox...'); model = createpde(); R1 = [3,4,-1,1,1,-1,1,1,-1,-1]'; g = decsg(R1); geometryFromEdges(model,g);"
                    endif
                    
                    # 35160 - Curve Fitting Toolbox Runtime Addon
                    grep -q '^35160$' "$DEPS_FILE"
                    if ($status == 0) then
                        set warmup_code = "${warmup_code} disp('---> Testing Curve Fitting Toolbox...'); xdata = (0:0.1:1)'; ydata = xdata.^2; f = fit(xdata, ydata, 'poly2');"
                    endif
                    
                    set warmup_code = "${warmup_code} disp('---> Warmup complete.');"
                    
                    # Create the warmup MATLAB file
                    set warmup_m_file = "$warmup_dir/warmup_runtime.m"
                    echo "function warmup_runtime()" > "$warmup_m_file"
                    echo "$warmup_code" >> "$warmup_m_file"
                    echo "end" >> "$warmup_m_file"
                    
                    # Compile the warmup function
                    echo "Compiling warmup function:"
                    set temp_matlab_script = "/tmp/matlab_cmd_warmup_$$.m"
                    printf "mcc -m -w off -o warmup_runtime -d '%s' '%s'\n" "$warmup_dir" "$warmup_m_file" > "$temp_matlab_script"
                    matlab -nodisplay -nosplash -nodesktop -batch "run('$temp_matlab_script')" >& /dev/null
                    rm -f "$temp_matlab_script"
                    
                    if ($status == 0 && -f "$warmup_dir/run_warmup_runtime.sh") then
                        echo "---> Success: warmup function compiled"
                        echo ""
                        echo "Running warmup function (this may take a while):"
                        chmod +x "$warmup_dir/run_warmup_runtime.sh"
                        "$warmup_dir/run_warmup_runtime.sh" "$MATLAB_RUNTIME_DIR/$runtime_version" < /dev/null |& tail -n +6
                        
                        if ($status == 0) then
                            echo "---> Success: MATLAB Runtime warmed up"
                        else
                            echo ""
                            echo "---> Warning: Warmup completed with errors (runtime may still work)"
                        endif
                    else
                        echo "---> Warning: Could not compile warmup function, skipping warmup"
                    endif
                    
                    # Clean up warmup directory
                    rm -rf "$warmup_dir"

                    echo ""
                    echo "============================================================================================================="
                    echo "Initialization of MATLAB Runtime application completed"
                    echo "============================================================================================================="

                endif
                
            else
                echo "---> Failed: MATLAB Runtime installation incomplete (no version directory found)"
            endif
        endif
    else
        echo "-> Warning: Could not find runtime installer executable in $RUNTIME_DIR"
    endif
    
else
    echo "---> Runtime installer up to date, no reinstallation needed"
endif

rm -f "$temp_deps_new"

# Restore startup.m
if ($had_startup == 1) then
    mv "$STARTUP_BACKUP" "$STARTUP_FILE"
endif

echo ""
echo -n "Compiled files location"
echo ": $OUTPUT_DIR"
if (-d "$MATLAB_RUNTIME_DIR") then
    echo -n "MATLAB Runtime location"
    echo ": $MATLAB_RUNTIME_DIR"
endif

exit 0
