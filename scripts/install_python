#! /usr/bin/env tcsh

# Download, compile and install a local SOLPS-ITER-specific Python installation
# (also sourced by install_dependencies, which then handles the local setup file and the final messages)

if ( ! $?RESTART_SOLPS ) set RESTART_SOLPS = 0
if ( ! $?MISSING_PYTHON ) set MISSING_PYTHON = 0

if ( ! $?PY_FROM_INSTALL_DEPENDENCIES ) then

  # Create the local setup file, if it does not already exist, where to append the Python activation

  if (! -e "${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local") then
    touch ${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local
  else
    cp ${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local ${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local.bak
  endif

  if (! -d "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}" ) then
    mkdir -p "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}"
  endif

endif

# Python series: the latest micro version of this series is downloaded when the installation is
# first built. A later run never updates the micro version. If PYTHON_SERIES is changed, an existing
# installation of another series is deleted and rebuilt from scratch, with all the modules below.
set PYTHON_SERIES = 3.13
# Required external Python modules ("name>=minimum" or just "name"). On every run, the modules that
# are missing or too old are installed with pip, so new entries can simply be appended here.
set PYTHON_MODULES = ( "numpy>=1.21" "matplotlib>=3.8" "PySide6>=6.4" )

set PY_URL    = "https://www.python.org/ftp/python"
set PY_PREFIX = "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}/python"
set PY_BIN    = "${PY_PREFIX}/bin/python3"
set PY_BUILD  = 0   # 1: build the Python core from source
set PY_OK     = 0   # 1: a usable Python core of the required series is present

if (! -e "${PY_PREFIX}" ) then   # Check if the local Python installation already exists

  echo
  echo Local SOLPS-ITER-specific Python installation not found.
  echo It provides Python ${PYTHON_SERIES} with all the modules needed by the SOLPS-ITER Python tools:
  echo "$PYTHON_MODULES:q"
  echo and will take precedence over any other Python installations already existing on this computer.
  echo -n "Do you want to install a local SOLPS-ITER-specific Python installation? It will be downloaded and locally compiled in SOLPSLIB. (y/n) [y] "
  set PY_INSTALL = $<

  if ( "$PY_INSTALL" == "" ) then
    set PY_INSTALL = "y"
  endif

  if ( "$PY_INSTALL" == "y" ) then
    set PY_BUILD = 1
  else
    sleep 1
  endif

else   # Check that the existing installation is usable and belongs to the required series

  set PY_HAVE = ""
  if ( -x "${PY_BIN}" ) set PY_HAVE = `"${PY_BIN}" -I -c 'import sys; print("%d.%d" % sys.version_info[:2])' |& tail -1`

  if ( "$PY_HAVE" == "$PYTHON_SERIES" ) then
    set PY_OK = 1
    set PY_FULL = `"${PY_BIN}" -I -c 'import platform; print(platform.python_version())'`
    echo
    echo "Local SOLPS-ITER-specific Python installation already present (Python ${PY_FULL})."
    sleep 1
  else
    echo
    if ( `echo "$PY_HAVE" | grep -c '^[0-9][0-9]*\.[0-9][0-9]*$'` == 1 ) then
      echo The local SOLPS-ITER-specific Python installation is Python ${PY_HAVE}, but Python ${PYTHON_SERIES} is now required.
    else
      echo The local SOLPS-ITER-specific Python installation in ${PY_PREFIX} is not usable.
    endif
    echo It will be deleted and replaced by a new one, compiled from scratch, with all required modules.
    echo Modules that you installed into it yourself will be lost.
    echo -n "Do you want to replace the local SOLPS-ITER-specific Python installation? (y/n) [y] "
    set PY_INSTALL = $<

    if ( "$PY_INSTALL" == "" ) then
      set PY_INSTALL = "y"
    endif

    if ( "$PY_INSTALL" == "y" ) then
      rm -rf "${PY_PREFIX}"
      set PY_BUILD = 1
    else
      sleep 1
    endif
  endif

endif

if ( "$PY_BUILD" == "1" ) then

  # Development packages needed to build the Python standard library (ssl and zlib are needed by pip)

  if ("$OSTYPE" == "linux" && "$HOST_NAME" == "LINUX") then

    set PY_DEV_MISSING = ()
    foreach pkg ( libssl-dev zlib1g-dev libffi-dev libbz2-dev liblzma-dev libsqlite3-dev )
      dpkg -s $pkg >& /dev/null
      if ( $status != 0 ) set PY_DEV_MISSING = ( $PY_DEV_MISSING $pkg )
    end

    if ( $#PY_DEV_MISSING != 0 ) then
      echo
      echo Development packages needed to compile Python not locally installed: $PY_DEV_MISSING
      echo -n "Do you wish to install them? The apt package manager will be used. (y/n) [y] "
      set PY_DEV_INSTALL = $<

      if ( "$PY_DEV_INSTALL" == "" ) then
        set PY_DEV_INSTALL = "y"
      endif

      if ( "$PY_DEV_INSTALL" == "y" ) then
        sudo apt-get install -y $PY_DEV_MISSING
      endif
    endif

  else if ("$OSTYPE" == "darwin") then

    if ( `brew list | grep -c '^openssl@3$'` == 0 ) then
      echo
      echo OpenSSL library, needed to compile Python, not locally installed.
      echo -n "Do you wish to install it? The brew package manager will be used. (y/n) [y] "
      set OPENSSL_INSTALL = $<

      if ( "$OPENSSL_INSTALL" == "" ) then
        set OPENSSL_INSTALL = "y"
      endif

      if ( "$OPENSSL_INSTALL" == "y" ) then
        brew install openssl@3
      endif
    endif

  endif

  # Build options: the build must not pick up flags or Python settings from the SOLPS-ITER environment.

  if ("$OSTYPE" == "darwin") then
    set PY_BUILD_ENV = ( env -u CFLAGS -u CPPFLAGS -u CXXFLAGS -u LDFLAGS -u PKG_CONFIG_PATH -u PYTHONPATH -u PYTHONHOME )
    set PY_CONFIGURE_EXTRA = ( CC=clang "--with-openssl=`brew --prefix openssl@3`" ac_cv_header_libintl_h=no )
  else
    set PY_BUILD_ENV = ( env -u CFLAGS -u CPPFLAGS -u CXXFLAGS -u LDFLAGS -u PYTHONPATH -u PYTHONHOME )
    set PY_CONFIGURE_EXTRA = ( CC=gcc )
  endif
  set PY_NCPU = `getconf _NPROCESSORS_ONLN`

  # Find the latest released micro version of the required series

  set PY_CANDIDATES = ( `curl -fsSL "${PY_URL}/" | grep -o 'href="[0-9.]*/"' | tr -d 'href="/' | grep -x "${PYTHON_SERIES}\.[0-9]*" | sort -t . -k 3,3n` )
  set PY_VERSION = ""
  @ i = $#PY_CANDIDATES
  while ( $i > 0 && "$PY_VERSION" == "" )   # The newest directory may hold only pre-releases
    curl -fsIL -o /dev/null "${PY_URL}/$PY_CANDIDATES[$i]/Python-$PY_CANDIDATES[$i].tgz"
    if ( $status == 0 ) set PY_VERSION = $PY_CANDIDATES[$i]
    @ i--
  end

  if ( "$PY_VERSION" == "" ) then

    echo
    echo Error: no Python ${PYTHON_SERIES} release found at ${PY_URL}. Check the internet connection.
    sleep 1

  else

    echo
    echo Building Python ${PY_VERSION} from source in ${PY_PREFIX}.
    set RESTART_SOLPS = 1
    set PY_SRC = "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}/Python-${PY_VERSION}"
    cd "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}"
    rm -rf "${PY_SRC}" "${PY_SRC}.tgz"
    curl -fL -o "${PY_SRC}.tgz" "${PY_URL}/${PY_VERSION}/Python-${PY_VERSION}.tgz" && \
    tar xzf "${PY_SRC}.tgz" && \
    cd "${PY_SRC}" && \
    $PY_BUILD_ENV ./configure --prefix="${PY_PREFIX}" --disable-test-modules --with-ensurepip=install $PY_CONFIGURE_EXTRA:q && \
    $PY_BUILD_ENV make -j ${PY_NCPU} && \
    $PY_BUILD_ENV make install
    set PY_BUILD_STATUS = $status
    cd $SOLPSTOP
    rm -rf "${PY_SRC}" "${PY_SRC}.tgz"

    if ( "$PY_BUILD_STATUS" == "0" ) then
      "${PY_BIN}" -I -c 'import ssl, zlib, ctypes' >& /dev/null
      set PY_BUILD_STATUS = $status
      if ( "$PY_BUILD_STATUS" != "0" ) then
        echo
        echo Error: Python was compiled without the ssl, zlib or ctypes modules.
        echo Install the OpenSSL, zlib and libffi development packages and relaunch the install_python script.
      endif
    endif

    if ( "$PY_BUILD_STATUS" == "0" ) then
      ln -sf python3 "${PY_PREFIX}/bin/python"
      ln -sf pip3 "${PY_PREFIX}/bin/pip"
      set PY_OK = 1
      echo Python ${PY_VERSION} successfully installed.
      sleep 1
    else
      rm -rf "${PY_PREFIX}"   # A broken installation must not be activated by setup.csh
      echo
      echo Error: the local SOLPS-ITER-specific Python installation failed.
      sleep 1
    endif

  endif

endif

if ( "$PY_OK" == "1" ) then

  # Install the required modules that are missing or too old

  set PY_MISSING = ()
  foreach spec ( $PYTHON_MODULES:q )
    set name = `echo "$spec" | sed 's/>=.*//'`
    set vmin = `echo "$spec" | sed -n 's/.*>=//p'`
    if ( "$vmin" == "" ) set vmin = 0
    "${PY_BIN}" -I -c 'import re, sys; from importlib.metadata import version; t = lambda s: tuple(int(x) for x in re.findall("[0-9]+", s)[:3]); sys.exit(0 if t(version(sys.argv[1])) >= t(sys.argv[2]) else 2)' "$name" "$vmin" >& /dev/null
    if ( $status != 0 ) set PY_MISSING = ( $PY_MISSING:q "$spec" )
  end

  if ( $#PY_MISSING != 0 ) then
    echo
    echo Installing Python modules into the local SOLPS-ITER-specific Python installation: $PY_MISSING:q
    "${PY_BIN}" -I -m pip --isolated install --no-cache-dir --disable-pip-version-check $PY_MISSING:q
    if ( $status == 0 ) then
      echo Python modules successfully installed.
    else
      echo Error: the installation of the Python modules failed.
    endif
    sleep 1
  else
    echo
    echo All required Python modules already installed in the local SOLPS-ITER-specific Python installation.
    sleep 1
  endif

  # Activate the local Python installation at every "source setup.csh", in front of any other Python

  if ( `grep -c 'SOLPS-ITER-specific Python installation' ${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local` == 0 ) then
    set RESTART_SOLPS = 1
cat >> ${SOLPSTOP}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local << 'PYTHON_LOCAL_ENV'

# --- SOLPS-ITER-specific Python installation (added by install_python) ---
if ( -x "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}/python/bin/python3" ) then
    setenv PATH "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}/python/bin:${PATH}"
    setenv PYTHON "${SOLPSTOP}/lib/${HOST_NAME}.${COMPILER}/python/bin/python3"
    if ( $?PYTHONHOME ) unsetenv PYTHONHOME
endif
'PYTHON_LOCAL_ENV'
  endif

endif

# Warn at the end only if no usable local installation exists and no other Python is available either

if ( "$PY_OK" != "1" ) then
  which python3 >& /dev/null
  if ( $status != 0 ) set MISSING_PYTHON = 1
endif

if ( ! $?PY_FROM_INSTALL_DEPENDENCIES ) then

  if ( "$MISSING_PYTHON" == "1" ) then
    echo
    echo Warning: no Python installation is available.
    echo Relaunch the install_python script to install a local SOLPS-ITER-specific Python installation.
  endif

  if ( "$RESTART_SOLPS" == "1" ) then
    echo
    echo The local SOLPS-ITER-specific Python installation has been activated
    echo in \$\{SOLPSTOP\}/SETUP/setup.csh.${HOST_NAME}.${COMPILER}.local.
    echo Please close your SOLPS-ITER session and your shell and restart them.
  endif

endif
